# Required web application values
DATABASE_URL=<postgresql-connection-url>
BETTER_AUTH_SECRET=<random-high-entropy-value-at-least-32-characters>
BETTER_AUTH_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
REVALIDATE_SECRET=<independent-random-secret>

# Optional database diagnostics
DB_QUERY_TIMING=0
DB_SLOW_QUERY_MS=100

# Optional Trigger.dev workflows (the project itself is set in trigger.config.ts)
TRIGGER_SECRET_KEY=<trigger-secret-key>

# Optional source for pnpm db:clone:supabase
# SUPABASE_DATABASE_URL=

# One-time inputs: export in the invoking shell for one command; do not persist here
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# COCOACOMAA_BOOTSTRAP_ADMIN_ACKNOWLEDGE_SHARED_DATABASE=
# CONFIRM_CLONE=
# ORDER_COLUMNS_DATABASE_URL=
# ORDER_COLUMNS_CONFIRMATION_TOKEN=
# COCOACOMAA_ORDER_COLUMNS_ACKNOWLEDGEMENT=
